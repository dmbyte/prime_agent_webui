[Unit]
Description=Prime OpenShell task runner broker
After=prime-model-gateway.service
Requires=prime-model-gateway.service

[Service]
Type=simple
User=prime-runner
Group=prime-runner
SupplementaryGroups=prime-web prime-local-access
RuntimeDirectory=prime-runner
RuntimeDirectoryMode=0750
Environment=XDG_RUNTIME_DIR=/run/user/@RUNNER_UID@
Environment=PRIME_WEB_OWNER=@WEB_OWNER@
Environment=PRIME_TASK_RUNTIME=openshell
Environment=PRIME_RUNNER_WORKSPACE_ROOT=/home/@WEB_OWNER@/prime-agent/tasks
ExecStartPre=/usr/bin/python3 /usr/local/libexec/prime-runner-recover @WEB_OWNER@ /home/@WEB_OWNER@/prime-agent/tasks
ExecStart=/usr/bin/python3 /usr/local/lib/prime-runner/runner_broker.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=no
InaccessiblePaths=/root
ReadWritePaths=/var/lib/prime-runner /run/prime-runner /home/@WEB_OWNER@/prime-agent
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
