[Unit]
Description=Prime WebUI isolated PAM session broker
After=network.target

[Service]
Type=simple
Environment=PRIME_AUTH_USER=dbyte
ExecStart=/usr/bin/python3 %h/prime-dgx-dashboard/auth.py
Restart=on-failure
RestartSec=3
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
UMask=0077
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=default.target
