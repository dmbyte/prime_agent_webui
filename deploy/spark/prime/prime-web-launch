#!/usr/bin/env bash
set -euo pipefail

launcher="${HOME}/.local/bin/prime-dgx"
sessions="${HOME}/.prime/agent/sessions"

if [[ $# -eq 2 && $1 == "--resume" && $2 =~ ^[A-Za-z0-9_-]{8,80}$ && -f "${sessions}/$2.jsonl" ]]; then
  exec "${launcher}" --resume "$2"
fi

if [[ $# -eq 3 && $1 == "--attach" && $2 =~ ^[A-Za-z0-9_-]{8,80}$ && $3 == "--explicit" && -f "${sessions}/$2.jsonl" ]]; then
  exec "${launcher}" attach "$2"
fi

if [[ $# -gt 0 && $1 == "--attach" ]]; then
  echo "Explicit browser attachment requires a validated session ID and --explicit."
  exit 64
fi

# Browser-supplied arguments outside the exact resume and explicit attach forms are ignored.
exec "${launcher}"
