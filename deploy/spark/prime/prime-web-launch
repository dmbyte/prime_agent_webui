#!/usr/bin/env bash
set -euo pipefail

launcher="${HOME}/.local/bin/prime-dgx"
sessions="${HOME}/.prime/agent/sessions"

if [[ $# -eq 2 && $1 == "--resume" && $2 =~ ^[A-Za-z0-9_-]{8,80}$ && -f "${sessions}/$2.jsonl" ]]; then
  exec "${launcher}" --resume "$2"
fi

if [[ $# -gt 0 && $1 == "--attach" ]]; then
  echo "Browser session attachment is disabled. Use the activity event feed."
  exit 64
fi

# Browser-supplied arguments outside the exact resume form are ignored.
exec "${launcher}"
